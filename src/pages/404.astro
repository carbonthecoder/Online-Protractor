---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 — Page Not Found | Online Protractor"
  description="The requested page could not be found. Return to the Online Protractor tool."
>
  <Header slot="header" />

  <div class="max-w-xl mx-auto py-24 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-sky-500/10 border border-sky-500/30 text-sky-400">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
    </div>

    <h1 class="text-4xl font-extrabold text-zinc-100">404 — Page Not Found</h1>
    <p class="text-sm text-zinc-400 leading-relaxed max-w-md mx-auto">
      The angle or URL you are looking for does not exist or has moved. Return to the protractor tool to start measuring.
    </p>

    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-medium text-sm transition"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
        Back to Protractor
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
