---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404 — Page Not Found | Real Online Protractor"
  description="The requested page does not exist. Return to the Real Online Protractor."
>
  <Header slot="header" />

  <div class="min-h-[calc(100vh-140px)] flex flex-col items-center justify-center text-center px-4 select-none">
    <!-- Faded 404 Number (Matches Image 5) -->
    <h1 class="text-7xl sm:text-9xl font-black text-neutral-800/80 tracking-tight leading-none mb-3">
      404
    </h1>

    <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] mb-2">
      Page not found
    </h2>

    <p class="text-sm text-[var(--text-secondary)] max-w-sm mx-auto mb-8 leading-relaxed">
      The page you're looking for doesn't exist or may have been moved.
    </p>

    <div class="flex items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-neutral-100 text-neutral-900 font-medium text-xs hover:bg-white transition shadow-sm"
      >
        <span>&rarr;</span>
        <span>Open Protractor</span>
      </a>

      <a
        href="/about"
        class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-mat)] font-medium text-xs hover:bg-[var(--bg-surface-hover)] transition"
      >
        About
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
