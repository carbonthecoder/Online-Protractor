---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms & Conditions — Online Ruler"
  description="Terms and conditions for utilizing the Online Ruler tool."
>
  <Header slot="header" />

  <article class="max-w-3xl mx-auto px-4 py-12 space-y-6 text-[var(--text-secondary)] text-sm leading-relaxed">
    <header class="space-y-1">
      <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Terms & Conditions</h1>
      <p class="text-xs text-[var(--text-muted)]">Effective Date: October 19, 2026</p>
    </header>

    <section class="space-y-2">
      <h2 class="text-base font-bold text-[var(--text-primary)]">1. Acceptance of Terms</h2>
      <p>
        By accessing Online Ruler, you agree to be bound by these terms. If you disagree with any part of these terms, you should discontinue use immediately.
      </p>
    </section>

    <section class="space-y-2">
      <h2 class="text-base font-bold text-[var(--text-primary)]">2. Permitted Use</h2>
      <p>
        Online Ruler is provided free of charge for personal, commercial, educational, and trade drafting use. You may not disrupt service availability or scrape the application through automated abuse.
      </p>
    </section>

    <section class="space-y-2">
      <h2 class="text-base font-bold text-[var(--text-primary)]">3. Accuracy Disclaimer</h2>
      <p>
        Calculations are performed with geometric precision in software. However, physical accuracy depends on your screen's pixel aspect ratio, device scaling, and user alignment. For structural construction or critical engineering tolerances, verify all measurements with calibrated physical instruments.
      </p>
    </section>
  </article>

  <Footer slot="footer" />
</Layout>
