---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProtractorTool from '../components/ProtractorTool.astro';
import AngleGuides from '../components/AngleGuides.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<Layout
  title="Online Protractor — Free On-Screen Angle Finder & Camera Tool"
  description="Free interactive online protractor. Measure angles on screen, from live camera, or uploaded photos. Features 180° semi-circle & 360° circle modes, magnetic snapping, degrees, radians, and slope."
>
  <Header slot="header" />

  <!-- Hero Section -->
  <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      100% Free Client-Side Tool • No Sign-up Required
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-zinc-100 tracking-tight leading-tight">
      Online Protractor & Angle Finder
    </h1>
    <p class="mt-3 text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
      Calibrated digital protractor for measuring angles on images, live camera streams, or blank canvases. Supports 180° semi-circle and 360° full rotation with magnetic angle snapping.
    </p>
  </div>

  <!-- Interactive Protractor Application -->
  <ProtractorTool />

  <!-- SEO Educational Content -->
  <AngleGuides />

  <!-- FAQ Section with Schema.org -->
  <FaqAccordion />

  <Footer slot="footer" />
</Layout>
