---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProtractorTool from '../components/ProtractorTool.astro';
import AngleGuides from '../components/AngleGuides.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import HowToUseModal from '../components/HowToUseModal.astro';
---

<Layout
  title="Online Ruler — Free Calibrated Protractor & Angle Measurement Tool"
  description="Online Ruler turns your screen into a calibrated angle finder. Measure actual angles in degrees, radians, and slope from screen, camera feeds, or uploaded photos."
>
  <Header slot="header" />

  <!-- Fullscreen Interactive Canvas Workspace (Above the fold) -->
  <ProtractorTool />

  <!-- How to Use Modal Dialog -->
  <HowToUseModal />

  <!-- Educational Guide on Scroll (Flat, no curved corners, matching realonlineruler.com) -->
  <AngleGuides />

  <!-- Common Questions Accordion (Flat, no curved corners) -->
  <div class="relative z-10 w-full bg-[var(--bg-main)] border-t border-[var(--border-color)] pb-16 px-4 sm:px-6 rounded-none">
    <FaqAccordion />
  </div>

  <Footer slot="footer" />
</Layout>
