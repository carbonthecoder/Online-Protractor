---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact — Online Ruler"
  description="Get in touch with the Online Ruler team for feedback, feature requests, or bug reports."
>
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 py-12 space-y-6 text-[var(--text-secondary)] text-sm">
    <header class="space-y-2">
      <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Contact</h1>
      <p class="text-xs text-[var(--text-muted)]">Have feedback, discovered a bug, or want to suggest a new tool feature?</p>
    </header>

    <div class="bg-[var(--bg-card)] border border-[var(--border-color)] rounded-xl p-6 space-y-4">
      <div class="space-y-1.5">
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Email</h2>
        <p class="text-xs text-[var(--text-secondary)]">Reach our inbox for feedback or feature suggestions:</p>
        <p class="text-xs font-mono text-blue-400">contact@onlineruler.pages.dev</p>
      </div>

      <div class="border-t border-[var(--border-color)] pt-4 space-y-1.5">
        <h2 class="text-sm font-semibold text-[var(--text-primary)]">Bug Reports</h2>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          Please include your device model, browser version (Chrome, Safari, Firefox), and screen resolution when reporting measurement issues.
        </p>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
