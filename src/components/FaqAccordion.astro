---
// Interactive FAQ section with Schema.org FAQPage JSON-LD
const faqs = [
  {
    question: "Can I use my phone or laptop camera to measure angles?",
    answer: "Yes. Click Camera in the toolbar to stream your camera live behind the calibrated protractor. You can align real-world cuts, tools, or physical drawings without printing or installing an app."
  },
  {
    question: "How do I move, scale, or rotate an uploaded image?",
    answer: "After uploading an image or pasting via Ctrl+V, click the 'Edit Image' button at the bottom. You can drag the image across the canvas, use the scale slider (or scroll wheel) to zoom in and out, and rotate the image by 90° increments to match your lines."
  },
  {
    question: "How accurate is an online protractor?",
    answer: "Calculations on screen are geometrically exact down to 0.1 degrees. Accuracy when measuring physical objects or photos depends on holding your device flat to avoid optical perspective distortion."
  },
  {
    question: "What is the difference between the 180° and 360° scales?",
    answer: "The 180° mode emulates a standard semi-circular geometry protractor with dual inner and outer scales. The 360° mode displays a full circular compass dial for reflex angles and navigational bearings."
  },
  {
    question: "Is Online Ruler free and does it store my images?",
    answer: "Yes, it is 100% free with no registration required. All photo processing, camera streams, and measurements execute entirely in your local browser memory. Zero data is uploaded to any server."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="pt-12 text-[var(--text-secondary)] max-w-3xl mx-auto">
  <div class="space-y-4">
    <div>
      <h2 class="text-lg sm:text-xl font-bold text-[var(--text-primary)] tracking-tight">
        Frequently Asked Questions
      </h2>
    </div>

    <!-- Accordion List -->
    <div class="space-y-2">
      {faqs.map((faq) => (
        <details class="group bg-[var(--bg-card)] border border-[var(--border-color)] rounded-lg overflow-hidden transition-colors">
          <summary class="flex items-center justify-between p-3.5 cursor-pointer list-none font-medium text-xs sm:text-sm text-[var(--text-primary)] hover:opacity-85 transition">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 text-[var(--text-muted)] group-open:rotate-180 transition-transform">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </summary>
          <div class="px-3.5 pb-3.5 pt-1 text-xs text-[var(--text-secondary)] leading-relaxed border-t border-[var(--border-color)]">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
