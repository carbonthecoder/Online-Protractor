---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--border-color)] bg-[var(--bg-header)] text-[var(--text-muted)] text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-4 text-[11px]">
      <a href="/" class="font-semibold text-[var(--text-primary)] hover:opacity-85">Online Ruler</a>
      <a href="/about" class="hover:text-[var(--text-primary)] transition">About</a>
      <a href="/contact" class="hover:text-[var(--text-primary)] transition">Contact</a>
      <a href="/privacy-policy" class="hover:text-[var(--text-primary)] transition">Privacy Policy</a>
      <a href="/terms-and-conditions" class="hover:text-[var(--text-primary)] transition">Terms & Conditions</a>
    </div>

    <div class="text-[11px] text-[var(--text-muted)]">
      &copy; {currentYear} Online Ruler. Free to use, no sign-up required.
    </div>
  </div>
</footer>
