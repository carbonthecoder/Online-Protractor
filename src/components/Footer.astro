---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 bg-zinc-950 mt-16 text-zinc-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2 font-bold text-zinc-100">
          <div class="w-6 h-6 rounded bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.21 15.89A10 10 0 1 1 8 2.83" />
              <path d="M22 12A10 10 0 0 0 12 2v10z" />
            </svg>
          </div>
          <span>Online<span class="text-sky-400">Protractor</span></span>
        </div>
        <p class="text-zinc-400 text-xs leading-relaxed max-w-sm">
          A high-precision, client-side digital protractor designed for students, carpenters, engineers, and designers. 100% free, runs locally in your browser, and requires no registration.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider mb-3">Quick Links</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-zinc-100 transition-colors">Angle Finder Tool</a></li>
          <li><a href="/#guide" class="hover:text-zinc-100 transition-colors">Angle Types & Formulas</a></li>
          <li><a href="/#faq" class="hover:text-zinc-100 transition-colors">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-zinc-200 uppercase tracking-wider mb-3">Legal & Support</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about" class="hover:text-zinc-100 transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-zinc-100 transition-colors">Contact</a></li>
          <li><a href="/privacy-policy" class="hover:text-zinc-100 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-zinc-100 transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-zinc-900 mt-8 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-400 gap-4">
      <p>&copy; {currentYear} OnlineProtractor. All rights reserved.</p>
      <p class="text-zinc-400">All angle calculations execute locally on your device.</p>
    </div>
  </div>
</footer>
