---
// Clean 'How to Use' Modal Dialog matching realonlineruler.com
---

<div
  id="guide-modal"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity duration-200 select-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-title"
>
  <div class="relative w-full max-w-lg bg-[var(--bg-card)] border border-[var(--border-color)] rounded-xl shadow-2xl overflow-hidden p-6 text-[var(--text-primary)]">
    <!-- Close Button -->
    <button
      id="btn-close-guide"
      type="button"
      class="absolute top-4 right-4 text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded hover:bg-[var(--bg-hover)] transition"
      aria-label="Close dialog"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <div class="space-y-6">
      <div>
        <span class="text-[11px] font-semibold text-[var(--text-muted)] uppercase tracking-wider">Guide</span>
        <h2 id="guide-title" class="text-xl font-bold mt-1 text-[var(--text-primary)]">
          How to Use the Ruler & Protractor
        </h2>
      </div>

      <!-- Step 1 -->
      <div class="flex items-start gap-3">
        <div class="w-6 h-6 rounded-full bg-[var(--bg-main)] border border-[var(--border-color)] flex items-center justify-center text-xs font-bold text-[var(--text-primary)] flex-shrink-0">
          1
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">Align the Vertex</h3>
          <p class="text-xs text-[var(--text-secondary)] mt-0.5 leading-relaxed">
            Drag the center brass pivot directly over the intersection point where your two angle rays meet.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex items-start gap-3">
        <div class="w-6 h-6 rounded-full bg-[var(--bg-main)] border border-[var(--border-color)] flex items-center justify-center text-xs font-bold text-[var(--text-primary)] flex-shrink-0">
          2
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">Measure and Add Guide Lines</h3>
          <p class="text-xs text-[var(--text-secondary)] mt-0.5 leading-relaxed">
            Align the base pin with the horizontal baseline. Drag the white indicator knob along the angle to get live readings in degrees, radians, or slope.
          </p>
        </div>
      </div>

      <!-- Keyboard Shortcuts Grid -->
      <div class="border-t border-[var(--border-color)] pt-4 space-y-3">
        <h4 class="text-xs font-semibold text-[var(--text-primary)] uppercase tracking-wider">
          Keyboard Shortcuts
        </h4>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Toggle 180° / 360°</span>
            <kbd class="px-1.5 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">M</kbd>
          </div>
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Toggle Snap</span>
            <kbd class="px-1.5 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">S</kbd>
          </div>
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Switch units</span>
            <span class="space-x-1">
              <kbd class="px-1 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">1</kbd>
              <kbd class="px-1 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">2</kbd>
              <kbd class="px-1 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">3</kbd>
            </span>
          </div>
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Toggle fullscreen</span>
            <kbd class="px-1.5 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">F</kbd>
          </div>
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Toggle dark mode</span>
            <kbd class="px-1.5 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">D</kbd>
          </div>
          <div class="flex items-center justify-between bg-[var(--bg-main)] px-2.5 py-1.5 rounded border border-[var(--border-color)]">
            <span class="text-[var(--text-secondary)] text-[11px]">Toggle this guide</span>
            <kbd class="px-1.5 py-0.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded font-mono text-[10px]">H</kbd>
          </div>
        </div>
      </div>

      <!-- Got it Action Button -->
      <div class="pt-2">
        <button
          id="btn-got-it"
          type="button"
          class="w-full py-2.5 rounded-lg bg-[var(--text-primary)] text-[var(--bg-main)] font-semibold text-xs hover:opacity-90 transition shadow-sm"
        >
          Got it
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('guide-modal');
  const openBtn = document.getElementById('btn-open-guide');
  const closeBtn = document.getElementById('btn-close-guide');
  const gotItBtn = document.getElementById('btn-got-it');

  const openModal = () => {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }
  };

  if (openBtn) openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (gotItBtn) gotItBtn.addEventListener('click', closeModal);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Keyboard shortcut 'H'
  window.addEventListener('keydown', (e) => {
    if (e.key === 'h' || e.key === 'H') {
      if (modal && modal.classList.contains('flex')) {
        closeModal();
      } else {
        openModal();
      }
    } else if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
