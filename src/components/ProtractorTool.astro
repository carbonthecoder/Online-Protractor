---
// Technical Fullscreen Protractor with Sticky Curtain Scroll & Crisp White Accents
---

<div id="tool-container" class="sticky top-12 z-0 w-full h-[calc(100vh-48px)] bg-[var(--bg-main)] canvas-grid overflow-hidden select-none flex items-center justify-center">
  <!-- Hidden Media Streams -->
  <video id="camera-stream" autoplay playsinline muted class="hidden"></video>

  <!-- HTML5 Canvas -->
  <canvas id="protractor-canvas" class="w-full h-full block cursor-crosshair"></canvas>

  <!-- Floating Measurement Badge (Matches realonlineruler.com style) -->
  <div
    id="floating-badge"
    class="absolute pointer-events-none px-3.5 py-2 rounded-lg bg-[var(--bg-card)]/90 border border-[var(--border-color)] text-[var(--text-primary)] shadow-2xl backdrop-blur-md flex items-baseline gap-2.5 z-20"
    style="top: 20px; left: 24px;"
  >
    <span class="text-[var(--text-secondary)] font-mono text-xs font-semibold">θ:</span>
    <span id="badge-primary" class="font-londrina text-2xl sm:text-3xl tracking-wide text-white">0.0°</span>
    <span class="text-[var(--border-color)]">|</span>
    <span id="badge-secondary" class="font-mono text-[var(--text-secondary)] text-xs">0.000 rad</span>
  </div>

  <!-- Floating Image Adjustments Panel (Compact floating toolbox in top-right: zero modal backdrop, zero background blur) -->
  <div
    id="image-settings-panel"
    class="absolute top-4 right-4 z-40 hidden w-72 sm:w-80 bg-[var(--bg-card)]/95 border border-[var(--border-color)] rounded-xl shadow-2xl p-4 space-y-3 text-xs select-none max-h-[calc(100vh-100px)] overflow-y-auto"
  >
    <!-- Header: Title and Close button (No extra tabs) -->
    <div class="flex items-center justify-between pb-2 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
        <span class="font-semibold text-sm text-[var(--text-primary)]">Image Settings</span>
      </div>
      <button id="btn-close-img-settings" type="button" class="text-[var(--text-muted)] hover:text-white p-1 rounded hover:bg-[var(--bg-hover)] transition cursor-pointer" title="Close settings">
        ✕
      </button>
    </div>

    <!-- Replace & Clear row -->
    <div class="flex items-center gap-2">
      <label class="flex-1 py-1.5 px-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium cursor-pointer transition flex items-center justify-center gap-1.5 shadow-sm">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        Replace
        <input id="input-replace-img" type="file" accept="image/*" class="hidden" />
      </label>
      <button id="btn-clear-img-settings" type="button" class="py-1.5 px-3 rounded-lg border border-red-500/30 bg-red-950/20 text-red-400 hover:bg-red-900/30 text-xs font-medium transition flex items-center gap-1.5 cursor-pointer">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6" />
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
        </svg>
        Clear
      </button>
    </div>

    <!-- Placement: Offset X & Offset Y -->
    <div class="space-y-2 pt-1 border-t border-[var(--border-color)]">
      <span class="text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">Placement</span>
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <span class="text-[var(--text-secondary)]">Offset X</span>
          <div class="flex items-center gap-2">
            <input id="img-offset-x-slider" type="range" min="-500" max="500" value="0" class="w-24 sm:w-28 accent-blue-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
            <span id="img-offset-x-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">0px</span>
          </div>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-[var(--text-secondary)]">Offset Y</span>
          <div class="flex items-center gap-2">
            <input id="img-offset-y-slider" type="range" min="-500" max="500" value="0" class="w-24 sm:w-28 accent-blue-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
            <span id="img-offset-y-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">0px</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Appearance: Scale -->
    <div class="space-y-1.5 pt-1 border-t border-[var(--border-color)]">
      <span class="text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">Appearance</span>
      <div class="flex items-center justify-between text-xs">
        <span class="text-[var(--text-secondary)]">Scale</span>
        <div class="flex items-center gap-2">
          <input id="img-scale-slider" type="range" min="10" max="300" value="100" class="w-24 sm:w-28 accent-purple-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
          <span id="img-scale-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">1.0x</span>
        </div>
      </div>
    </div>

    <!-- Transform: Rotation & Flip -->
    <div class="space-y-2 pt-1 border-t border-[var(--border-color)]">
      <span class="text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">Transform</span>
      <div class="flex items-center justify-between text-xs">
        <span class="text-[var(--text-secondary)]">Rotation</span>
        <div class="flex items-center gap-2">
          <input id="img-rot-slider" type="range" min="0" max="360" value="0" class="w-24 sm:w-28 accent-blue-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
          <span id="img-rot-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">0°</span>
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <button id="btn-rot-left" type="button" class="flex-1 py-1 px-1.5 rounded bg-[var(--bg-main)] hover:bg-[var(--bg-hover)] border border-[var(--border-color)] text-[11px] text-[var(--text-primary)] transition cursor-pointer">
          ↺ -90°
        </button>
        <button id="btn-rot-right" type="button" class="flex-1 py-1 px-1.5 rounded bg-[var(--bg-main)] hover:bg-[var(--bg-hover)] border border-[var(--border-color)] text-[11px] text-[var(--text-primary)] transition cursor-pointer">
          ↻ +90°
        </button>
        <button id="btn-rot-reset" type="button" class="py-1 px-2 rounded bg-[var(--bg-main)] hover:bg-[var(--bg-hover)] border border-[var(--border-color)] text-[11px] text-[var(--text-muted)] hover:text-white transition cursor-pointer">
          Reset
        </button>
      </div>
      <div class="flex items-center gap-2 pt-1">
        <button id="btn-img-flip-h" type="button" class="flex-1 py-1 rounded bg-[var(--bg-main)] hover:bg-[var(--bg-hover)] border border-[var(--border-color)] text-[11px] text-[var(--text-primary)] transition cursor-pointer">
          Flip H
        </button>
        <button id="btn-img-flip-v" type="button" class="flex-1 py-1 rounded bg-[var(--bg-main)] hover:bg-[var(--bg-hover)] border border-[var(--border-color)] text-[11px] text-[var(--text-primary)] transition cursor-pointer">
          Flip V
        </button>
      </div>
    </div>

    <!-- Adjustments: Brightness & Contrast -->
    <div class="space-y-2 pt-1 border-t border-[var(--border-color)]">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-semibold tracking-wider text-[var(--text-muted)] uppercase">Adjustments</span>
        <button id="btn-adj-reset" type="button" class="text-[11px] text-[var(--text-muted)] hover:text-white transition cursor-pointer">Reset</button>
      </div>
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <span class="text-[var(--text-secondary)]">Brightness</span>
          <div class="flex items-center gap-2">
            <input id="img-brightness-slider" type="range" min="20" max="200" value="100" class="w-24 sm:w-28 accent-amber-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
            <span id="img-brightness-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">100%</span>
          </div>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-[var(--text-secondary)]">Contrast</span>
          <div class="flex items-center gap-2">
            <input id="img-contrast-slider" type="range" min="20" max="200" value="100" class="w-24 sm:w-28 accent-purple-500 h-1.5 bg-[var(--border-color)] rounded cursor-pointer" />
            <span id="img-contrast-val" class="font-mono text-[11px] text-[var(--text-muted)] w-10 text-right">100%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Done button -->
    <div class="pt-2 border-t border-[var(--border-color)]">
      <button id="btn-done-img-settings" type="button" class="w-full py-1.5 rounded-lg bg-[var(--text-primary)] text-[var(--bg-main)] font-semibold text-xs hover:opacity-90 transition shadow-sm cursor-pointer">
        Done
      </button>
    </div>
  </div>

  <!-- Left Floating Vertical Dock (Collapsible side drawer anchored at left-2) -->
  <aside
    id="side-dock-container"
    class="fixed left-2 top-1/2 -translate-y-1/2 z-20 flex items-center select-none"
    aria-label="Measurement Tools"
  >
    <!-- Dock Body -->
    <div
      id="side-dock-body"
      class="flex flex-col items-center bg-[var(--bg-card)]/95 backdrop-blur-md border border-[var(--border-color)] rounded-xl p-1.5 gap-1.5 shadow-2xl transition-all duration-300"
    >
      <!-- 180 / 360 Mode Toggle -->
      <button
        id="side-btn-mode"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Switch to 360° full disc (M)"
      >
        <svg id="side-icon-mode" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
          <line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 2" stroke-width="1.2" />
        </svg>
        <span id="side-mode-tooltip" class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Switch to 360° (M)
        </span>
      </button>

      <!-- Snap Toggle -->
      <button
        id="side-btn-snap"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-white bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Snap: 5° (Click to change: 5° → 15° → 45° → Off)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 3v7a6 6 0 0 0 12 0V3" />
          <line x1="4" y1="3" x2="8" y2="3" />
          <line x1="16" y1="3" x2="20" y2="3" />
        </svg>
        <span id="side-snap-tooltip" class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Snap: 5° (S)
        </span>
      </button>

      <span class="w-5 h-px bg-[var(--border-color)]"></span>

      <!-- Upload Image -->
      <label
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] cursor-pointer transition relative group"
        title="Upload image / blueprint"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <polyline points="21 15 16 10 5 21" />
        </svg>
        <input id="side-input-file" type="file" accept="image/*" class="hidden" />
        <span class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Upload Image (Ctrl+V)
        </span>
      </label>

      <!-- Camera Mode -->
      <button
        id="side-btn-camera"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Live Camera Angle Finder"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
        <span class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Camera Mode
        </span>
      </button>

      <span class="w-5 h-px bg-[var(--border-color)]"></span>

      <!-- Flip Baseline (Clean bilateral horizontal arrows ⇋) -->
      <button
        id="side-btn-flip"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Flip Baseline 180°"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="17 8 21 12 17 16" />
          <line x1="21" y1="12" x2="9" y2="12" />
          <polyline points="7 16 3 12 7 8" />
          <line x1="3" y1="12" x2="15" y2="12" />
        </svg>
        <span class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Flip Baseline
        </span>
      </button>

      <!-- Export Annotated PNG -->
      <button
        id="side-btn-export"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Export PNG snapshot"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Export PNG
        </span>
      </button>

      <!-- Lock/Unlock Protractor Widget (L) -->
      <button
        id="side-btn-lock"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Lock / Unlock moving and sizing (L)"
      >
        <svg id="side-icon-lock" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 9.9-1" />
        </svg>
        <span id="side-lock-tooltip" class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Lock Position & Size (L)
        </span>
      </button>

      <!-- Reset Protractor & Points -->
      <button
        id="side-btn-reset"
        type="button"
        class="w-8 h-8 rounded-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] transition relative group cursor-pointer"
        title="Reset Protractor & Points (R)"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
        </svg>
        <span class="absolute left-full ml-2.5 px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[11px] whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition shadow-lg z-30">
          Reset All (R)
        </span>
      </button>
    </div>

    <!-- Collapse/Expand Tab Handle (Permanently anchored at left edge, perfectly vertically centered) -->
    <button
      id="side-dock-toggle"
      type="button"
      class="h-9 w-5 bg-[var(--bg-card)]/95 hover:bg-[var(--bg-hover)] backdrop-blur-md border border-[var(--border-color)] border-l-0 rounded-r-lg flex items-center justify-center text-[var(--text-secondary)] hover:text-white transition shadow-xl cursor-pointer"
      title="Toggle sidebar dock"
      aria-label="Toggle sidebar dock"
    >
      <svg id="side-toggle-arrow" class="w-3.5 h-3.5 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>
  </aside>

  <!-- Bottom Floating Control Bar -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-[var(--bg-card)]/95 border border-[var(--border-color)] px-3 py-1.5 rounded-full shadow-xl backdrop-blur flex items-center gap-2 text-xs z-20">
    <button id="btn-edit-image" type="button" class="hidden px-2.5 py-1 rounded hover:bg-[var(--bg-hover)] text-white font-medium transition cursor-pointer" title="Adjust background image">
      Edit Image
    </button>
    <span id="sep-edit-img" class="hidden w-px h-3.5 bg-[var(--border-color)]"></span>
    <button id="btn-undo-point" type="button" class="hidden px-2 py-1 rounded hover:bg-[var(--bg-hover)] text-[var(--text-secondary)] hover:text-white transition cursor-pointer" title="Undo last point">
      ↺ Undo Point
    </button>
    <button id="btn-clear-points" type="button" class="hidden px-2 py-1 rounded hover:bg-[var(--bg-hover)] text-[var(--text-secondary)] hover:text-white transition cursor-pointer" title="Reset to Point 1">
      ✕ Clear Points
    </button>
    <span id="sep-points" class="hidden w-px h-3.5 bg-[var(--border-color)]"></span>
    <button id="btn-copy" type="button" class="px-3 py-1 rounded hover:bg-[var(--bg-hover)] text-[var(--text-primary)] font-mono text-xs flex items-center gap-1.5 transition cursor-pointer">
      <svg class="w-3.5 h-3.5 text-[var(--text-secondary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <span id="copy-label">Copy 0.0°</span>
    </button>
    <button id="btn-clear-media" type="button" class="hidden px-2 py-1 rounded bg-neutral-800 text-neutral-300 hover:bg-neutral-700 transition cursor-pointer" title="Remove image">
      ✕ Clear Image
    </button>
  </div>
</div>

<script>
  class FullscreenProtractorEngine {
    constructor() {
      this.canvas = document.getElementById('protractor-canvas');
      this.ctx = this.canvas.getContext('2d');
      this.video = document.getElementById('camera-stream');

      // State
      this.mode = '180'; // '180' or '360'
      this.unit = 'deg'; // 'deg' | 'rad' | 'slope'
      this.snapEnabled = true;
      this.snapStep = 5;
      this.opacity = 0.90;
      this.isLocked = false;
      this.isCameraActive = false;
      this.backgroundImage = null;
      this.mediaStream = null;

      // Image Transform & Adjustments State
      this.imgTransform = {
        x: 0,
        y: 0,
        offsetX: 0,
        offsetY: 0,
        scale: 1.0,
        rotation: 0, // radians
        flipH: false,
        flipV: false,
        brightness: 100, // %
        contrast: 100,   // %
      };

      // Coordinates
      this.origin = { x: 0, y: 0 };
      this.armLength = 260;

      // Multi-point measurement system (matching Image 1 & user's new uploaded image)
      // Initially, only Line 1 (Point 1 reference ray) exists.
      // Clicking anywhere drops Point 2, Point 3, Point 4... which remain stationary where placed.
      this.points = [];

      // Drag State
      this.activeHandle = null; // { type: 'point', index: number } | { type: 'origin' } | { type: 'resizeRight' } | { type: 'resizeLeft' }
      this.dragOffset = { x: 0, y: 0 };

      this.initElements();
      this.setupEventListeners();
      this.resizeCanvas();
      this.requestRender();
    }

    initElements() {
      this.badgePrimary = document.getElementById('badge-primary');
      this.badgeSecondary = document.getElementById('badge-secondary');
      this.copyLabel = document.getElementById('copy-label');
      this.btnCopy = document.getElementById('btn-copy');
      this.btnClearMedia = document.getElementById('btn-clear-media');

      // Points buttons
      this.btnUndoPoint = document.getElementById('btn-undo-point');
      this.btnClearPoints = document.getElementById('btn-clear-points');
      this.sepPoints = document.getElementById('sep-points');

      // Floating image settings panel elements
      this.imageSettingsPanel = document.getElementById('image-settings-panel');
      this.btnEditImage = document.getElementById('btn-edit-image');
      this.sepEditImg = document.getElementById('sep-edit-img');
      this.btnCloseImgSettings = document.getElementById('btn-close-img-settings');
      this.btnDoneImgSettings = document.getElementById('btn-done-img-settings');
      this.btnClearImgSettings = document.getElementById('btn-clear-img-settings');
      this.inputReplaceImg = document.getElementById('input-replace-img');
      this.imgOffsetXSlider = document.getElementById('img-offset-x-slider');
      this.imgOffsetXVal = document.getElementById('img-offset-x-val');
      this.imgOffsetYSlider = document.getElementById('img-offset-y-slider');
      this.imgOffsetYVal = document.getElementById('img-offset-y-val');
      this.imgScaleSlider = document.getElementById('img-scale-slider');
      this.imgScaleVal = document.getElementById('img-scale-val');
      this.imgRotSlider = document.getElementById('img-rot-slider');
      this.imgRotVal = document.getElementById('img-rot-val');
      this.btnRotLeft = document.getElementById('btn-rot-left');
      this.btnRotRight = document.getElementById('btn-rot-right');
      this.btnRotReset = document.getElementById('btn-rot-reset');
      this.btnImgFlipH = document.getElementById('btn-img-flip-h');
      this.btnImgFlipV = document.getElementById('btn-img-flip-v');
      this.btnAdjReset = document.getElementById('btn-adj-reset');
      this.imgBrightnessSlider = document.getElementById('img-brightness-slider');
      this.imgBrightnessVal = document.getElementById('img-brightness-val');
      this.imgContrastSlider = document.getElementById('img-contrast-slider');
      this.imgContrastVal = document.getElementById('img-contrast-val');

      // Header controls
      this.unitDeg = document.getElementById('unit-deg');
      this.unitRad = document.getElementById('unit-rad');
      this.unitSlope = document.getElementById('unit-slope');

      // Sidebar dock controls
      this.sideBtnMode = document.getElementById('side-btn-mode');
      this.sideIconMode = document.getElementById('side-icon-mode');
      this.sideModeTooltip = document.getElementById('side-mode-tooltip');
      this.sideBtnSnap = document.getElementById('side-btn-snap');
      this.sideSnapTooltip = document.getElementById('side-snap-tooltip');
      this.sideInputFile = document.getElementById('side-input-file');
      this.sideBtnCamera = document.getElementById('side-btn-camera');
      this.sideBtnFlip = document.getElementById('side-btn-flip');
      this.sideBtnExport = document.getElementById('side-btn-export');
      this.sideBtnLock = document.getElementById('side-btn-lock');
      this.sideIconLock = document.getElementById('side-icon-lock');
      this.sideLockTooltip = document.getElementById('side-lock-tooltip');
      this.sideBtnReset = document.getElementById('side-btn-reset');
    }

    setupEventListeners() {
      window.addEventListener('resize', () => this.resizeCanvas());
      window.addEventListener('theme-change', () => this.requestRender());

      // 1. Dynamic Mode Toggle (180° vs 360°)
      const updateModeUI = () => {
        if (this.mode === '180') {
          if (this.sideIconMode) {
            this.sideIconMode.innerHTML = `<circle cx="12" cy="12" r="9" /><line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 2" stroke-width="1.2" />`;
          }
          if (this.sideModeTooltip) this.sideModeTooltip.textContent = 'Switch to 360° (M)';
          if (this.sideBtnMode) this.sideBtnMode.title = 'Switch to 360° full disc (M)';
        } else {
          if (this.sideIconMode) {
            this.sideIconMode.innerHTML = `<path d="M21 12A9 9 0 0 0 3 12h18z" fill="currentColor" fill-opacity="0.1" />`;
          }
          if (this.sideModeTooltip) this.sideModeTooltip.textContent = 'Switch to 180° (M)';
          if (this.sideBtnMode) this.sideBtnMode.title = 'Switch to 180° semi-circle (M)';
        }
      };

      if (this.sideBtnMode) {
        this.sideBtnMode.addEventListener('click', () => {
          this.mode = this.mode === '180' ? '360' : '180';
          updateModeUI();
          this.resetPositions();
          this.requestRender();
        });
      }

      // 2. Snap Toggle (5° -> 15° -> 45° -> Off -> 5°)
      const snapSteps = [5, 15, 45, 0];
      let snapIndex = 0;
      if (this.sideBtnSnap) {
        this.sideBtnSnap.addEventListener('click', () => {
          snapIndex = (snapIndex + 1) % snapSteps.length;
          const currentStep = snapSteps[snapIndex];
          if (currentStep === 0) {
            this.snapEnabled = false;
            this.sideBtnSnap.classList.remove('text-white', 'bg-[var(--bg-hover)]');
            this.sideBtnSnap.classList.add('text-[var(--text-secondary)]');
            if (this.sideSnapTooltip) this.sideSnapTooltip.textContent = 'Snap: Off (S)';
            this.sideBtnSnap.title = 'Snap: Off';
          } else {
            this.snapEnabled = true;
            this.snapStep = currentStep;
            this.sideBtnSnap.classList.add('text-white', 'bg-[var(--bg-hover)]');
            this.sideBtnSnap.classList.remove('text-[var(--text-secondary)]');
            if (this.sideSnapTooltip) this.sideSnapTooltip.textContent = `Snap: ${currentStep}° (S)`;
            this.sideBtnSnap.title = `Snap: ${currentStep}°`;
          }
        });
      }

      // 3. Flip Baseline (Mirror 180°)
      if (this.sideBtnFlip) {
        this.sideBtnFlip.addEventListener('click', () => {
          if (this.points.length > 0) {
            this.points[0].angle = (this.points[0].angle + Math.PI) % (Math.PI * 2);
          }
          this.updateReadouts();
          this.requestRender();
        });
      }

      // 4. Camera Toggle
      if (this.sideBtnCamera) {
        this.sideBtnCamera.addEventListener('click', () => this.toggleCamera());
      }

      // 5. Image File Upload
      if (this.sideInputFile) {
        this.sideInputFile.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) this.loadImageFromFile(e.target.files[0]);
        });
      }

      // 6. Export Annotated PNG
      if (this.sideBtnExport) {
        this.sideBtnExport.addEventListener('click', () => this.exportPNG());
      }

      // 7. Lock / Unlock Protractor (L)
      // Locking ONLY locks moving center vertex and baseline resize handles; points remain active!
      const toggleLock = () => {
        this.isLocked = !this.isLocked;
        if (this.isLocked) {
          if (this.sideBtnLock) {
            this.sideBtnLock.classList.add('text-amber-400', 'bg-amber-500/20', 'border', 'border-amber-500/40');
            this.sideBtnLock.classList.remove('text-[var(--text-secondary)]');
            this.sideBtnLock.title = 'Position & size locked (L to unlock)';
          }
          if (this.sideLockTooltip) this.sideLockTooltip.textContent = 'Unlock Position & Size (L)';
          if (this.sideIconLock) {
            this.sideIconLock.innerHTML = `<rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />`;
          }
        } else {
          if (this.sideBtnLock) {
            this.sideBtnLock.classList.remove('text-amber-400', 'bg-amber-500/20', 'border', 'border-amber-500/40');
            this.sideBtnLock.classList.add('text-[var(--text-secondary)]');
            this.sideBtnLock.title = 'Lock Position & Size (L)';
          }
          if (this.sideLockTooltip) this.sideLockTooltip.textContent = 'Lock Position & Size (L)';
          if (this.sideIconLock) {
            this.sideIconLock.innerHTML = `<rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" />`;
          }
        }
        this.requestRender();
      };

      if (this.sideBtnLock) {
        this.sideBtnLock.addEventListener('click', toggleLock);
      }

      // 8. Reset All (R)
      if (this.sideBtnReset) {
        this.sideBtnReset.addEventListener('click', () => {
          this.resetPositions();
          this.requestRender();
        });
      }

      // Points management buttons
      if (this.btnUndoPoint) {
        this.btnUndoPoint.addEventListener('click', () => {
          if (this.points.length > 1) {
            this.points.pop();
            this.updateReadouts();
            this.requestRender();
          }
        });
      }
      if (this.btnClearPoints) {
        this.btnClearPoints.addEventListener('click', () => {
          if (this.points.length > 1) {
            this.points = [this.points[0]];
            this.updateReadouts();
            this.requestRender();
          }
        });
      }

      // Collapsible Sidebar Dock Handle
      const sideDockBody = document.getElementById('side-dock-body');
      const sideDockToggle = document.getElementById('side-dock-toggle');
      const sideToggleArrow = document.getElementById('side-toggle-arrow');
      let isDockCollapsed = false;

      if (sideDockToggle && sideDockBody) {
        sideDockToggle.addEventListener('click', () => {
          isDockCollapsed = !isDockCollapsed;
          if (isDockCollapsed) {
            sideDockBody.classList.add('hidden');
            if (sideToggleArrow) sideToggleArrow.style.transform = 'rotate(180deg)';
            sideDockToggle.classList.remove('border-l-0', 'rounded-r-lg');
            sideDockToggle.classList.add('rounded-lg');
          } else {
            sideDockBody.classList.remove('hidden');
            if (sideToggleArrow) sideToggleArrow.style.transform = 'rotate(0deg)';
            sideDockToggle.classList.add('border-l-0', 'rounded-r-lg');
            sideDockToggle.classList.remove('rounded-lg');
          }
        });
      }

      // Clipboard Paste Support (Ctrl+V)
      window.addEventListener('paste', (e) => {
        if (!e.clipboardData || !e.clipboardData.items) return;
        for (let i = 0; i < e.clipboardData.items.length; i++) {
          const item = e.clipboardData.items[i];
          if (item.type.indexOf('image') !== -1) {
            const blob = item.getAsFile();
            if (blob) {
              this.loadImageFromFile(blob);
              e.preventDefault();
              break;
            }
          }
        }
      });

      // Unit switch
      const setUnit = (u) => {
        this.unit = u;
        [this.unitDeg, this.unitRad, this.unitSlope].forEach(b => {
          if (!b) return;
          b.className = 'px-2 py-0.5 rounded font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer';
        });
        const active = u === 'deg' ? this.unitDeg : (u === 'rad' ? this.unitRad : this.unitSlope);
        if (active) active.className = 'px-2 py-0.5 rounded font-semibold bg-[var(--bg-header)] text-[var(--text-primary)] shadow-sm cursor-pointer';
        this.updateReadouts();
      };
      if (this.unitDeg) this.unitDeg.addEventListener('click', () => setUnit('deg'));
      if (this.unitRad) this.unitRad.addEventListener('click', () => setUnit('rad'));
      if (this.unitSlope) this.unitSlope.addEventListener('click', () => setUnit('slope'));

      // Copy Angle
      if (this.btnCopy) {
        this.btnCopy.addEventListener('click', () => {
          const deg = this.getPrimaryAngle();
          navigator.clipboard.writeText(`${deg.toFixed(1)}°`).then(() => {
            this.copyLabel.textContent = 'Copied!';
            setTimeout(() => this.updateReadouts(), 1600);
          });
        });
      }

      // Floating Image Adjustments Panel Toggle
      if (this.btnEditImage) {
        this.btnEditImage.addEventListener('click', () => this.toggleImageSettingsPanel(true));
      }
      if (this.btnCloseImgSettings) {
        this.btnCloseImgSettings.addEventListener('click', () => this.toggleImageSettingsPanel(false));
      }
      if (this.btnDoneImgSettings) {
        this.btnDoneImgSettings.addEventListener('click', () => this.toggleImageSettingsPanel(false));
      }

      // Replace image
      if (this.inputReplaceImg) {
        this.inputReplaceImg.addEventListener('change', (e) => {
          if (e.target.files && e.target.files[0]) this.loadImageFromFile(e.target.files[0]);
        });
      }

      // Clear image
      if (this.btnClearImgSettings) {
        this.btnClearImgSettings.addEventListener('click', () => {
          this.clearImage();
          this.toggleImageSettingsPanel(false);
        });
      }

      // Placement: Offset X & Y sliders
      if (this.imgOffsetXSlider) {
        this.imgOffsetXSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.offsetX = val;
          this.imgOffsetXVal.textContent = `${val}px`;
          this.requestRender();
        });
      }
      if (this.imgOffsetYSlider) {
        this.imgOffsetYSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.offsetY = val;
          this.imgOffsetYVal.textContent = `${val}px`;
          this.requestRender();
        });
      }

      // Appearance: Scale slider
      if (this.imgScaleSlider) {
        this.imgScaleSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.scale = val / 100;
          this.imgScaleVal.textContent = `${(val / 100).toFixed(1)}x`;
          this.requestRender();
        });
      }

      // Transform: Rotation slider & buttons
      if (this.imgRotSlider) {
        this.imgRotSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.rotation = (val * Math.PI) / 180;
          this.imgRotVal.textContent = `${val}°`;
          this.requestRender();
        });
      }
      if (this.btnRotLeft) {
        this.btnRotLeft.addEventListener('click', () => {
          let deg = Math.round((this.imgTransform.rotation * 180) / Math.PI) - 90;
          while (deg < 0) deg += 360;
          this.imgTransform.rotation = (deg * Math.PI) / 180;
          this.imgRotSlider.value = deg;
          this.imgRotVal.textContent = `${deg}°`;
          this.requestRender();
        });
      }
      if (this.btnRotRight) {
        this.btnRotRight.addEventListener('click', () => {
          let deg = (Math.round((this.imgTransform.rotation * 180) / Math.PI) + 90) % 360;
          this.imgTransform.rotation = (deg * Math.PI) / 180;
          this.imgRotSlider.value = deg;
          this.imgRotVal.textContent = `${deg}°`;
          this.requestRender();
        });
      }
      if (this.btnRotReset) {
        this.btnRotReset.addEventListener('click', () => {
          this.imgTransform.rotation = 0;
          this.imgRotSlider.value = 0;
          this.imgRotVal.textContent = '0°';
          this.requestRender();
        });
      }

      // Flip: Horizontal & Vertical
      if (this.btnImgFlipH) {
        this.btnImgFlipH.addEventListener('click', () => {
          this.imgTransform.flipH = !this.imgTransform.flipH;
          this.btnImgFlipH.classList.toggle('border-blue-500', this.imgTransform.flipH);
          this.requestRender();
        });
      }
      if (this.btnImgFlipV) {
        this.btnImgFlipV.addEventListener('click', () => {
          this.imgTransform.flipV = !this.imgTransform.flipV;
          this.btnImgFlipV.classList.toggle('border-blue-500', this.imgTransform.flipV);
          this.requestRender();
        });
      }

      // Adjustments: Brightness, Contrast & Reset
      if (this.imgBrightnessSlider) {
        this.imgBrightnessSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.brightness = val;
          this.imgBrightnessVal.textContent = `${val}%`;
          this.requestRender();
        });
      }
      if (this.imgContrastSlider) {
        this.imgContrastSlider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value, 10);
          this.imgTransform.contrast = val;
          this.imgContrastVal.textContent = `${val}%`;
          this.requestRender();
        });
      }
      if (this.btnAdjReset) {
        this.btnAdjReset.addEventListener('click', () => {
          this.imgTransform.brightness = 100;
          this.imgTransform.contrast = 100;
          this.imgBrightnessSlider.value = 100;
          this.imgBrightnessVal.textContent = '100%';
          this.imgContrastSlider.value = 100;
          this.imgContrastVal.textContent = '100%';
          this.requestRender();
        });
      }

      // Bottom bar clear media
      if (this.btnClearMedia) {
        this.btnClearMedia.addEventListener('click', () => this.clearImage());
      }

      // Pointer Handlers
      this.canvas.addEventListener('pointerdown', (e) => this.onPointerDown(e));
      window.addEventListener('pointermove', (e) => this.onPointerMove(e));
      window.addEventListener('pointerup', () => this.onPointerUp());
      window.addEventListener('pointercancel', () => this.onPointerUp());

      // Right-click on point to delete it
      this.canvas.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        const pos = this.getPointerPos(e);
        const hitIdx = this.findPointAt(pos);
        if (hitIdx > 0) {
          this.points.splice(hitIdx, 1);
          this.points.forEach((pt, i) => pt.id = i + 1);
          this.updateReadouts();
          this.requestRender();
        }
      });

      // Keyboard Shortcuts
      window.addEventListener('keydown', (e) => {
        if (e.target.tagName === 'INPUT') return;
        const key = e.key.toLowerCase();
        if (key === '1') setUnit('deg');
        if (key === '2') setUnit('rad');
        if (key === '3') setUnit('slope');
        if (key === 'm' && this.sideBtnMode) this.sideBtnMode.click();
        if (key === 's' && this.sideBtnSnap) this.sideBtnSnap.click();
        if (key === 'l') toggleLock();
        if (key === 'r' && this.sideBtnReset) this.sideBtnReset.click();
        if ((e.ctrlKey || e.metaKey) && key === 'z') {
          if (this.points.length > 1) {
            this.points.pop();
            this.updateReadouts();
            this.requestRender();
          }
        }
        if (key === 'f') {
          const fs = document.getElementById('btn-fullscreen');
          if (fs) fs.click();
        }
        if (key === 'd') {
          const th = document.getElementById('theme-toggle');
          if (th) th.click();
        }
        if (key === 'escape') {
          this.toggleImageSettingsPanel(false);
        }
      });
    }

    toggleImageSettingsPanel(open) {
      if (!this.imageSettingsPanel) return;
      if (open) {
        this.imageSettingsPanel.classList.remove('hidden');
      } else {
        this.imageSettingsPanel.classList.add('hidden');
      }
    }

    clearImage() {
      this.stopCamera();
      this.backgroundImage = null;
      if (this.btnEditImage) this.btnEditImage.classList.add('hidden');
      if (this.sepEditImg) this.sepEditImg.classList.add('hidden');
      if (this.btnClearMedia) this.btnClearMedia.classList.add('hidden');
      this.toggleImageSettingsPanel(false);
      this.requestRender();
    }

    resizeCanvas() {
      const rect = this.canvas.getBoundingClientRect();
      const dpr = Math.max(window.devicePixelRatio || 1, 2);

      this.canvas.width = Math.round(rect.width * dpr);
      this.canvas.height = Math.round(rect.height * dpr);

      this.ctx.resetTransform();
      this.ctx.scale(dpr, dpr);
      this.ctx.imageSmoothingEnabled = true;
      this.ctx.imageSmoothingQuality = 'high';

      this.armLength = Math.min(rect.width * 0.44, rect.height * 0.42, 280);

      if (!this.origin.x || !this.origin.y || this.origin.x > rect.width || this.origin.y > rect.height) {
        this.resetPositions();
      }

      this.requestRender();
    }

    resetPositions() {
      const rect = this.canvas.getBoundingClientRect();
      this.origin = {
        x: rect.width / 2,
        y: this.mode === '180' ? (rect.height * 0.68) : (rect.height / 2),
      };
      this.armLength = Math.min(rect.width * 0.44, rect.height * 0.42, 280);

      // Keep only Line 1 as initial reference ray
      this.points = [
        { id: 1, angle: 0, distance: this.armLength * 0.75 }
      ];
      this.updateReadouts();
    }

    loadImageFromFile(file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          this.stopCamera();
          this.backgroundImage = img;
          const rect = this.canvas.getBoundingClientRect();
          this.imgTransform.x = rect.width / 2;
          this.imgTransform.y = rect.height / 2;
          this.imgTransform.offsetX = 0;
          this.imgTransform.offsetY = 0;
          this.imgTransform.scale = Math.min(rect.width / img.width, rect.height / img.height, 1.0);
          this.imgTransform.rotation = 0;
          this.imgTransform.flipH = false;
          this.imgTransform.flipV = false;
          this.imgTransform.brightness = 100;
          this.imgTransform.contrast = 100;

          if (this.imgScaleSlider) {
            this.imgScaleSlider.value = Math.round(this.imgTransform.scale * 100);
            this.imgScaleVal.textContent = `${this.imgTransform.scale.toFixed(1)}x`;
          }
          if (this.imgOffsetXSlider) this.imgOffsetXSlider.value = 0;
          if (this.imgOffsetXVal) this.imgOffsetXVal.textContent = '0px';
          if (this.imgOffsetYSlider) this.imgOffsetYSlider.value = 0;
          if (this.imgOffsetYVal) this.imgOffsetYVal.textContent = '0px';
          if (this.imgRotSlider) this.imgRotSlider.value = 0;
          if (this.imgRotVal) this.imgRotVal.textContent = '0°';
          if (this.imgBrightnessSlider) this.imgBrightnessSlider.value = 100;
          if (this.imgBrightnessVal) this.imgBrightnessVal.textContent = '100%';
          if (this.imgContrastSlider) this.imgContrastSlider.value = 100;
          if (this.imgContrastVal) this.imgContrastVal.textContent = '100%';

          if (this.btnEditImage) this.btnEditImage.classList.remove('hidden');
          if (this.sepEditImg) this.sepEditImg.classList.remove('hidden');
          if (this.btnClearMedia) this.btnClearMedia.classList.remove('hidden');
          this.requestRender();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    async toggleCamera() {
      if (this.isCameraActive) {
        this.stopCamera();
        this.requestRender();
        return;
      }

      try {
        const constraints = { video: { facingMode: { ideal: 'environment' } } };
        this.mediaStream = await navigator.mediaDevices.getUserMedia(constraints);
        this.video.srcObject = this.mediaStream;
        await this.video.play();
        this.isCameraActive = true;
        this.backgroundImage = null;
        if (this.btnClearMedia) this.btnClearMedia.classList.remove('hidden');
        this.startCameraLoop();
      } catch (err) {
        alert('Camera access denied or unavailable.');
      }
    }

    stopCamera() {
      if (this.mediaStream) {
        this.mediaStream.getTracks().forEach((t) => t.stop());
        this.mediaStream = null;
      }
      this.isCameraActive = false;
    }

    startCameraLoop() {
      if (!this.isCameraActive) return;
      this.render();
      requestAnimationFrame(() => this.startCameraLoop());
    }

    getPointerPos(e) {
      const rect = this.canvas.getBoundingClientRect();
      return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
      };
    }

    getPointCoord(pt) {
      return {
        x: this.origin.x + Math.cos(pt.angle) * pt.distance,
        y: this.origin.y + Math.sin(pt.angle) * pt.distance,
      };
    }

    findPointAt(pos) {
      for (let i = 0; i < this.points.length; i++) {
        const pt = this.getPointCoord(this.points[i]);
        const dist = Math.hypot(pos.x - pt.x, pos.y - pt.y);
        if (dist <= 18) {
          return i;
        }
      }
      return -1;
    }

    getHandleCoords() {
      const r = this.armLength;
      return {
        origin: this.origin,
        resizeRight: {
          x: this.origin.x + r + 18,
          y: this.origin.y,
        },
        resizeLeft: {
          x: this.origin.x - r - 18,
          y: this.origin.y,
        },
      };
    }

    onPointerDown(e) {
      // Primary left click only for adding/moving points
      if (e.button && e.button !== 0) return;

      const pos = this.getPointerPos(e);

      // 1. Check if clicked on any existing point's red dot
      const hitPointIndex = this.findPointAt(pos);
      if (hitPointIndex !== -1) {
        this.activeHandle = { type: 'point', index: hitPointIndex };
        this.canvas.setPointerCapture(e.pointerId);
        return;
      }

      // 2. Check Bilateral Baseline Resize handles (Image 4) - only when unlocked
      if (!this.isLocked) {
        const handles = this.getHandleCoords();
        const distResizeR = Math.hypot(pos.x - handles.resizeRight.x, pos.y - handles.resizeRight.y);
        if (distResizeR <= 18) {
          this.activeHandle = { type: 'resizeRight' };
          this.canvas.setPointerCapture(e.pointerId);
          return;
        }

        if (this.mode === '180') {
          const distResizeL = Math.hypot(pos.x - handles.resizeLeft.x, pos.y - handles.resizeLeft.y);
          if (distResizeL <= 18) {
            this.activeHandle = { type: 'resizeLeft' };
            this.canvas.setPointerCapture(e.pointerId);
            return;
          }
        }

        // 3. Check Center Vertex (Origin move) - only when unlocked
        const distOrigin = Math.hypot(pos.x - this.origin.x, pos.y - this.origin.y);
        if (distOrigin <= 24) {
          this.activeHandle = { type: 'origin' };
          this.dragOffset = { x: pos.x - this.origin.x, y: pos.y - this.origin.y };
          this.canvas.setPointerCapture(e.pointerId);
          return;
        }
      }

      // 4. Clicked anywhere else: Drop a new measurement point!
      // Once placed, it stays fixed where placed ("does not move") unless dragged directly
      const dx = pos.x - this.origin.x;
      const dy = pos.y - this.origin.y;
      let angle = Math.atan2(dy, dx);
      let distance = Math.hypot(dx, dy);

      if (this.snapEnabled && this.points.length > 0) {
        const p1Angle = this.points[0].angle;
        const relAngle = angle - p1Angle;
        const relDeg = (relAngle * 180) / Math.PI;
        const snappedDeg = Math.round(relDeg / this.snapStep) * this.snapStep;
        if (Math.abs(relDeg - snappedDeg) <= 3.8) {
          angle = p1Angle + (snappedDeg * Math.PI) / 180;
        }
      }

      const newPoint = {
        id: this.points.length + 1,
        angle: angle,
        distance: Math.max(distance, 40),
      };
      this.points.push(newPoint);

      // Make this new point draggable
      this.activeHandle = { type: 'point', index: this.points.length - 1 };
      this.canvas.setPointerCapture(e.pointerId);

      this.updateReadouts();
      this.requestRender();
    }

    onPointerMove(e) {
      const pos = this.getPointerPos(e);

      if (this.activeHandle) {
        if (this.activeHandle.type === 'origin') {
          if (!this.isLocked) {
            this.origin = {
              x: pos.x - this.dragOffset.x,
              y: pos.y - this.dragOffset.y,
            };
          }
        } else if (this.activeHandle.type === 'resizeRight') {
          if (!this.isLocked) {
            const dx = pos.x - this.origin.x;
            this.armLength = Math.max(120, Math.min(dx - 18, 520));
          }
        } else if (this.activeHandle.type === 'resizeLeft') {
          if (!this.isLocked) {
            const dx = this.origin.x - pos.x;
            this.armLength = Math.max(120, Math.min(dx - 18, 520));
          }
        } else if (this.activeHandle.type === 'point') {
          const idx = this.activeHandle.index;
          if (this.points[idx]) {
            let rawAngle = Math.atan2(pos.y - this.origin.y, pos.x - this.origin.x);
            const dist = Math.hypot(pos.x - this.origin.x, pos.y - this.origin.y);

            if (this.snapEnabled && idx > 0 && this.points[0]) {
              const refAngle = this.points[0].angle;
              const relAngle = rawAngle - refAngle;
              const relDeg = (relAngle * 180) / Math.PI;
              const snappedDeg = Math.round(relDeg / this.snapStep) * this.snapStep;
              if (Math.abs(relDeg - snappedDeg) <= 3.8) {
                rawAngle = refAngle + (snappedDeg * Math.PI) / 180;
              }
            }

            this.points[idx].angle = rawAngle;
            this.points[idx].distance = Math.max(dist, 40);
          }
        }

        this.updateReadouts();
        this.requestRender();
        return;
      }

      this.updateHoverCursor(pos);
    }

    updateHoverCursor(pos) {
      // Over any point dot: grab cursor
      const hitIdx = this.findPointAt(pos);
      if (hitIdx !== -1) {
        this.canvas.style.cursor = 'grab';
        return;
      }

      // Center vertex: 4-directional move cursor when unlocked
      const distOrigin = Math.hypot(pos.x - this.origin.x, pos.y - this.origin.y);
      if (distOrigin <= 24) {
        this.canvas.style.cursor = this.isLocked ? 'crosshair' : 'move';
        return;
      }

      // Bilateral resize handles: ew-resize cursor when unlocked
      if (!this.isLocked) {
        const handles = this.getHandleCoords();
        const distResizeR = Math.hypot(pos.x - handles.resizeRight.x, pos.y - handles.resizeRight.y);
        const distResizeL = this.mode === '180' ? Math.hypot(pos.x - handles.resizeLeft.x, pos.y - handles.resizeLeft.y) : 999;
        if (distResizeR <= 18 || distResizeL <= 18) {
          this.canvas.style.cursor = 'ew-resize';
          return;
        }
      }

      // Default: crosshair for placing points
      this.canvas.style.cursor = 'crosshair';
    }

    onPointerUp() {
      this.activeHandle = null;
    }

    calculateAngleBetween(p1, p2) {
      let diff = Math.abs(p1.angle - p2.angle);
      while (diff >= Math.PI * 2) diff -= Math.PI * 2;
      let deg = (diff * 180) / Math.PI;
      if (this.mode === '180' && deg > 180) {
        deg = 360 - deg;
      }
      return deg;
    }

    getPrimaryAngle() {
      if (this.points.length >= 2) {
        return this.calculateAngleBetween(this.points[0], this.points[1]);
      } else if (this.points.length === 1) {
        let deg = Math.abs((this.points[0].angle * 180) / Math.PI);
        if (this.mode === '180' && deg > 180) deg = 360 - deg;
        return deg;
      }
      return 0;
    }

    updateReadouts() {
      const deg = this.getPrimaryAngle();
      const rad = (deg * Math.PI) / 180;
      const slope = Math.tan(rad) * 100;

      if (this.badgePrimary && this.badgeSecondary) {
        if (this.unit === 'deg') {
          this.badgePrimary.textContent = `${deg.toFixed(1)}°`;
          this.badgeSecondary.textContent = `${rad.toFixed(3)} rad`;
        } else if (this.unit === 'rad') {
          this.badgePrimary.textContent = `${rad.toFixed(3)} rad`;
          this.badgeSecondary.textContent = `${deg.toFixed(1)}°`;
        } else {
          this.badgePrimary.textContent = Math.abs(deg - 90) < 0.1 ? '90° Vertical' : `${Math.abs(slope).toFixed(1)}%`;
          this.badgeSecondary.textContent = `${deg.toFixed(1)}°`;
        }
      }

      if (this.copyLabel) {
        this.copyLabel.textContent = `Copy ${deg.toFixed(1)}°`;
      }

      // Toggle undo/clear points buttons in bottom bar
      if (this.btnUndoPoint && this.btnClearPoints && this.sepPoints) {
        if (this.points.length > 1) {
          this.btnUndoPoint.classList.remove('hidden');
          this.btnClearPoints.classList.remove('hidden');
          this.sepPoints.classList.remove('hidden');
        } else {
          this.btnUndoPoint.classList.add('hidden');
          this.btnClearPoints.classList.add('hidden');
          this.sepPoints.classList.add('hidden');
        }
      }
    }

    exportPNG() {
      const link = document.createElement('a');
      link.download = `online-protractor-${this.getPrimaryAngle().toFixed(1)}deg.png`;
      link.href = this.canvas.toDataURL('image/png');
      link.click();
    }

    isDark() {
      return document.documentElement.dataset.theme !== 'light';
    }

    requestRender() {
      if (!this.isCameraActive) {
        requestAnimationFrame(() => this.render());
      }
    }

    render() {
      const rect = this.canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;
      const ctx = this.ctx;

      ctx.clearRect(0, 0, w, h);

      // Camera stream
      if (this.isCameraActive && this.video.readyState >= 2) {
        const vW = this.video.videoWidth;
        const vH = this.video.videoHeight;
        const scale = Math.max(w / vW, h / vH);
        const dW = vW * scale;
        const dH = vH * scale;
        ctx.drawImage(this.video, (w - dW) / 2, (h - dH) / 2, dW, dH);
      }
      // Background Image with Move / Offset / Scale / Rotate / Flip / Brightness / Contrast
      else if (this.backgroundImage) {
        ctx.save();
        ctx.filter = `brightness(${this.imgTransform.brightness}%) contrast(${this.imgTransform.contrast}%)`;
        ctx.translate(this.imgTransform.x + this.imgTransform.offsetX, this.imgTransform.y + this.imgTransform.offsetY);
        ctx.rotate(this.imgTransform.rotation);
        ctx.scale(
          this.imgTransform.scale * (this.imgTransform.flipH ? -1 : 1),
          this.imgTransform.scale * (this.imgTransform.flipV ? -1 : 1)
        );
        const bW = this.backgroundImage.width;
        const bH = this.backgroundImage.height;
        ctx.drawImage(this.backgroundImage, -bW / 2, -bH / 2, bW, bH);
        ctx.restore();
      } else {
        this.drawGuideLines(w, h);
      }

      // Draw Protractor Body with Dual Scale & Bilateral Resize Handles (Image 1 & 4)
      this.drawUprightProtractor();

      // Draw Precision Rays, Numbered Pointers & Callout Badges (Image 1 & Uploaded User Image)
      this.drawHairlineArm();
    }

    drawGuideLines(w, h) {
      const ctx = this.ctx;
      const { x, y } = this.origin;
      const isDark = this.isDark();

      ctx.save();
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.10)' : 'rgba(0, 0, 0, 0.10)';
      ctx.lineWidth = 1;

      // Horizontal axis
      ctx.beginPath();
      ctx.moveTo(0, Math.round(y) + 0.5);
      ctx.lineTo(w, Math.round(y) + 0.5);
      ctx.stroke();

      // Vertical axis
      ctx.beginPath();
      ctx.moveTo(Math.round(x) + 0.5, 0);
      ctx.lineTo(Math.round(x) + 0.5, h);
      ctx.stroke();

      ctx.restore();
    }

    drawUprightProtractor() {
      const ctx = this.ctx;
      const r = Math.round(this.armLength);
      const x = Math.round(this.origin.x);
      const y = Math.round(this.origin.y);
      const is180 = this.mode === '180';
      const isDark = this.isDark();

      ctx.save();
      ctx.globalAlpha = this.opacity;

      // Acrylic Drop Shadow
      ctx.shadowColor = isDark ? 'rgba(0, 0, 0, 0.60)' : 'rgba(0, 0, 0, 0.12)';
      ctx.shadowBlur = 18;
      ctx.shadowOffsetY = 6;

      // Protractor Dome Body Fill
      ctx.beginPath();
      if (is180) {
        ctx.arc(x, y, r, Math.PI, 0, false);
        ctx.closePath();
      } else {
        ctx.arc(x, y, r, 0, Math.PI * 2, false);
      }

      ctx.fillStyle = isDark ? 'rgba(24, 26, 32, 0.88)' : 'rgba(255, 255, 255, 0.90)';
      ctx.fill();
      ctx.shadowColor = 'transparent';

      // Outer Beveled Rim
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.35)' : 'rgba(0, 0, 0, 0.30)';
      ctx.lineWidth = 1.6;
      ctx.stroke();

      // Inner Cutout Sight Window
      const innerR = Math.round(r * 0.44);
      ctx.beginPath();
      if (is180) {
        ctx.arc(x, y, innerR, Math.PI, 0, false);
        ctx.lineTo(x - innerR, y);
      } else {
        ctx.arc(x, y, innerR, 0, Math.PI * 2, false);
      }
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.22)' : 'rgba(0, 0, 0, 0.18)';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Laser-Engraved Degree Graduations (Dual Scale matching Image 1)
      const maxDeg = is180 ? 180 : 360;
      const tickColor = isDark ? '#ffffff' : '#000000';
      const tickSubtle = isDark ? 'rgba(255, 255, 255, 0.45)' : 'rgba(0, 0, 0, 0.40)';

      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let deg = 0; deg <= maxDeg; deg++) {
        const rad = (deg * Math.PI) / 180;
        const cos = Math.cos(rad);
        const sin = Math.sin(rad);

        const isMajor10 = deg % 10 === 0;
        const isSemi5 = deg % 5 === 0;

        let tickLen = 4;
        let stroke = tickSubtle;
        let lineW = 0.8;

        if (isMajor10) {
          tickLen = 14;
          stroke = tickColor;
          lineW = 1.4;
        } else if (isSemi5) {
          tickLen = 8;
          stroke = isDark ? 'rgba(255, 255, 255, 0.70)' : 'rgba(0, 0, 0, 0.60)';
          lineW = 1.1;
        }

        const ox = x + cos * r;
        const oy = y - sin * r;
        const ix = x + cos * (r - tickLen);
        const iy = y - sin * (r - tickLen);

        ctx.beginPath();
        ctx.moveTo(Math.round(ox), Math.round(oy));
        ctx.lineTo(Math.round(ix), Math.round(iy));
        ctx.strokeStyle = stroke;
        ctx.lineWidth = lineW;
        ctx.stroke();

        // Outer degree numbers: 0° on the right, 90° at top, 180° on left
        if (isMajor10 && (is180 || deg < 360)) {
          const textDist = r - 26;
          const tx = Math.round(x + cos * textDist);
          const ty = Math.round(y - sin * textDist);

          ctx.fillStyle = tickColor;
          ctx.font = '600 11px -apple-system, system-ui, sans-serif';
          ctx.fillText(`${deg}`, tx, ty);

          // Inner reverse scale for 180° mode (180 to 0) matching classroom protractors (Image 1)
          if (is180 && deg > 0 && deg < 180) {
            const innerTextDist = r - 42;
            const itx = Math.round(x + cos * innerTextDist);
            const ity = Math.round(y - sin * innerTextDist);
            ctx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.65)' : 'rgba(0, 0, 0, 0.60)';
            ctx.font = '500 9.5px -apple-system, system-ui, sans-serif';
            ctx.fillText(`${180 - deg}`, itx, ity);
          }
        }
      }

      // Millimeter Straight Edge along the Baseline
      if (is180) {
        ctx.beginPath();
        ctx.moveTo(x - r, y + 0.5);
        ctx.lineTo(x + r, y + 0.5);
        ctx.strokeStyle = tickColor;
        ctx.lineWidth = 1.4;
        ctx.stroke();

        const mmStep = (r * 0.90) / 10;
        for (let i = -10; i <= 10; i++) {
          const bx = Math.round(x + i * mmStep);
          const isCm = i % 2 === 0;
          const bLen = isCm ? 8 : 4;
          ctx.beginPath();
          ctx.moveTo(bx + 0.5, y);
          ctx.lineTo(bx + 0.5, y + bLen);
          ctx.strokeStyle = isCm ? tickColor : tickSubtle;
          ctx.lineWidth = isCm ? 1.2 : 0.7;
          ctx.stroke();
        }
      }

      // Bilateral Baseline Resize Handles (Image 4 ↔) - ONLY SHOWN WHEN UNLOCKED!
      if (!this.isLocked) {
        const drawResizeHandle = (hx, hy) => {
          ctx.save();
          ctx.shadowColor = 'rgba(0, 0, 0, 0.30)';
          ctx.shadowBlur = 6;
          ctx.shadowOffsetY = 2;

          ctx.beginPath();
          ctx.arc(hx, hy, 11, 0, Math.PI * 2);
          ctx.fillStyle = isDark ? '#1e293b' : '#ffffff';
          ctx.fill();
          ctx.strokeStyle = '#3b82f6';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.shadowColor = 'transparent';

          // Horizontal bilateral double arrows ↔
          ctx.beginPath();
          // Left arrow head
          ctx.moveTo(hx - 5, hy);
          ctx.lineTo(hx - 2, hy - 3);
          ctx.moveTo(hx - 5, hy);
          ctx.lineTo(hx - 2, hy + 3);
          // Center line
          ctx.moveTo(hx - 5, hy);
          ctx.lineTo(hx + 5, hy);
          // Right arrow head
          ctx.moveTo(hx + 5, hy);
          ctx.lineTo(hx + 2, hy - 3);
          ctx.moveTo(hx + 5, hy);
          ctx.lineTo(hx + 2, hy + 3);

          ctx.strokeStyle = '#3b82f6';
          ctx.lineWidth = 1.6;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.stroke();
          ctx.restore();
        };

        const handles = this.getHandleCoords();
        drawResizeHandle(handles.resizeRight.x, handles.resizeRight.y);
        if (is180) {
          drawResizeHandle(handles.resizeLeft.x, handles.resizeLeft.y);
        }
      }

      ctx.restore();
    }

    drawHairlineArm() {
      const ctx = this.ctx;
      const isDark = this.isDark();
      const origin = this.origin;

      ctx.save();

      // Distinct arc colors matching user's uploaded image (red, blue, purple, green, orange, pink)
      const arcColors = [
        '#ef4444', // Red
        '#3b82f6', // Blue
        '#8b5cf6', // Purple
        '#10b981', // Green
        '#f59e0b', // Amber/Orange
        '#ec4899', // Pink
        '#06b6d4', // Cyan
      ];

      // 1. Draw Angle Arcs & Callout Badges between Point 1 and subsequent points
      const p1 = this.points[0];
      if (p1 && this.points.length > 1) {
        for (let i = 1; i < this.points.length; i++) {
          const pi = this.points[i];
          const color = arcColors[(i - 1) % arcColors.length];
          const arcR = Math.min(36 + (i - 1) * 16, this.armLength * 0.7);

          const deg = this.calculateAngleBetween(p1, pi);

          // Render Arc
          ctx.beginPath();
          ctx.moveTo(origin.x, origin.y);
          ctx.arc(origin.x, origin.y, arcR, p1.angle, pi.angle, false);
          ctx.closePath();
          ctx.fillStyle = isDark ? `${color}20` : `${color}18`;
          ctx.fill();
          ctx.strokeStyle = color;
          ctx.lineWidth = 1.6;
          ctx.stroke();

          // Callout Badge along arc midpoint
          let midAngle = (p1.angle + pi.angle) / 2;
          if (Math.abs(p1.angle - pi.angle) > Math.PI) {
            midAngle += Math.PI;
          }
          const calloutDist = arcR + 22;
          const cx = origin.x + Math.cos(midAngle) * calloutDist;
          const cy = origin.y + Math.sin(midAngle) * calloutDist;
          const degText = `${deg.toFixed(1)}°`;

          ctx.font = '700 11px -apple-system, sans-serif';
          const textMetrics = ctx.measureText(degText);
          const boxW = textMetrics.width + 10;
          const boxH = 18;

          ctx.fillStyle = isDark ? '#14171f' : '#ffffff';
          ctx.fillRect(cx - boxW / 2, cy - boxH / 2, boxW, boxH);
          ctx.strokeStyle = color;
          ctx.lineWidth = 1.4;
          ctx.strokeRect(cx - boxW / 2, cy - boxH / 2, boxW, boxH);

          ctx.fillStyle = color;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(degText, cx, cy);
        }
      }

      // 2. Draw Rays and Numbered Points (1, 2, 3...)
      for (let i = 0; i < this.points.length; i++) {
        const pt = this.points[i];
        const ptCoord = this.getPointCoord(pt);

        // Red Hairline Ray from center to point
        ctx.beginPath();
        ctx.moveTo(origin.x, origin.y);
        ctx.lineTo(ptCoord.x, ptCoord.y);
        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 1.8;
        ctx.stroke();

        // Red circular dot with white border
        ctx.beginPath();
        ctx.arc(ptCoord.x, ptCoord.y, 5.5, 0, Math.PI * 2);
        ctx.fillStyle = '#ef4444';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Point number label above dot
        ctx.font = '700 12px -apple-system, sans-serif';
        ctx.fillStyle = isDark ? '#ffffff' : '#111827';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        ctx.fillText((i + 1).toString(), ptCoord.x, ptCoord.y - 7);
      }

      // 3. Center Vertex (Origin Target)
      if (!this.isLocked) {
        // Blue circular crosshair target circle matching Image 1
        ctx.beginPath();
        ctx.arc(origin.x, origin.y, 4, 0, Math.PI * 2);
        ctx.fillStyle = 'transparent';
        ctx.strokeStyle = '#3b82f6';
        ctx.lineWidth = 1.8;
        ctx.stroke();

        // Cross lines (+)
        ctx.beginPath();
        ctx.moveTo(origin.x - 9, origin.y);
        ctx.lineTo(origin.x + 9, origin.y);
        ctx.moveTo(origin.x, origin.y - 9);
        ctx.lineTo(origin.x, origin.y + 9);
        ctx.strokeStyle = '#3b82f6';
        ctx.lineWidth = 1.4;
        ctx.stroke();
      } else {
        ctx.beginPath();
        ctx.arc(origin.x, origin.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = isDark ? '#ffffff' : '#000000';
        ctx.fill();
      }

      ctx.restore();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new FullscreenProtractorEngine();
  });
</script>
